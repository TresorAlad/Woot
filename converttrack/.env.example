# ConvertTrack - variables locales (secrets)
# Copier vers .env et renseigner RODIUMAI_API_KEY

RODIUMAI_API_KEY=rd_sk_votre_cle
RODIUMAI_MODEL=mistral/ministral-3-14b-instruct
RODIUMAI_BASE_URL=https://api.rodiumai.io/v1

CHATWOOT_BASE_URL=http://127.0.0.1:3000
# CHATWOOT_API_TOKEN est injecte automatiquement depuis /shared/chatwoot_api_token

WEBHOOK_SECRET=changez_moi_secret_webhook

# Optionnel: creation auto du premier compte admin Chatwoot
# CONVERTTRACK_ADMIN_EMAIL=admin@example.com
# CONVERTTRACK_ADMIN_PASSWORD=ChangeMe123!
# CONVERTTRACK_ADMIN_NAME=ConvertTrack Admin
# CONVERTTRACK_ACCOUNT_NAME=ConvertTrack

# Assignation auto (IDs agents Chatwoot, optionnel)
# CONVERTTRACK_AGENT_DEFAULT=2
# CONVERTTRACK_AGENT_COMMERCIAL=2
# CONVERTTRACK_AGENT_SUPPORT=2
# CONVERTTRACK_AGENT_RELANCE=2

CONVERTTRACK_WEBHOOK_URL=http://127.0.0.1:5000/webhook/chatwoot
CONVERTTRACK_WEBSITE_URL=http://127.0.0.1:5000/test
